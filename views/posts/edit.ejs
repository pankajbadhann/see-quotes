<%- include("../layouts/header") %>

<div
  style="
    max-width:700px;
    margin:0 auto;
  "
>
  <h1>Edit Post</h1>

  <div
    style="
      background:white;
      padding:25px;
      border-radius:15px;
      box-shadow:var(--shadow);
    "
  >
    <form
      action="/posts/<%= post._id %>?_method=PATCH"
      method="POST"
    >
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <textarea
        name="content"
        required
        maxlength="500"
        style="
          min-height:180px;
          resize:vertical;
        "
      ><%= post.content %></textarea>

      <div
        style="
          margin-top:20px;
          display:flex;
          gap:10px;
        "
      >
        <button
          type="submit"
          class="btn"
        >
          Update Post
        </button>

        <a
          href="/posts"
          class="btn"
        >
          Cancel
        </a>
      </div>

    </form>
  </div>
</div>

<%- include("../layouts/footer") %>